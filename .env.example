# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# LinkedIn credentials (used by Playwright for posting AND profile analysis)
# Tip: create a dedicated browser profile and avoid 2FA-protected accounts for the demo
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your-password

# Replicate (image generation — Flux Schnell)
REPLICATE_API_TOKEN=r8_your-replicate-token
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Reddit (optional — only needed if you hit anonymous rate limits on r/listing.json)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Server
HOST=127.0.0.1
PORT=8000

# Storage
DATABASE_URL=sqlite:///./data/posts.db

# Posting mode: dry_run | manual_review | auto
POSTING_MODE=manual_review

# Schedules (cron format: minute hour day month weekday)
SCHEDULE_CRON=0 9 * * 1-5
TREND_REFRESH_CRON=0 7 * * *
